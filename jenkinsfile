pipeline{
    agent any
    stages{
        stage('checkout'){
            steps{
                git url: 'https://github.com/adwait888-coder/five' , branch:'main'
            }
        }
         stage('Build with gradle'){
            steps{
                sh '''
                    docker run --rm \
                    -v ${WORKSPACE}:/app \
                    -w /app \
                     gradle:jdk17 gradle clean bootJar
                    '''
                    }
                    }
    }
}